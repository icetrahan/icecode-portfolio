# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.next

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# stray game-server build artifacts that ended up in the repo root
# (anchored to root so public/SkinViewer 3D assets are unaffected)
/*.pak
/*.ucas
/*.utoc
/*.sig
/pakchunk*
/TheIsleServer-*
/TheIsle*.log
/Allo_Stats_*
/launcher.js
/cacheFile.json
/ticket_*.json

# heavy assets kept out of git — hosted externally / via CDN
/public/SkinViewer/
/public/PortMusic/
/public/cacheFile.json
/TheIsle*.log

# local build leftovers
/.next-stale/
