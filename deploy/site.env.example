# /home/container/site.env on the icecode.dev host — KEY=VALUE, one per line.
# Copy to site.env and fill in. Never commit the real file.

# Resend API key with send access to the FROM domain (required for the contact form).
RESEND_API_KEY=

# Optional overrides (defaults shown).
# CONTACT_TO=trahantech@gmail.com
# CONTACT_FROM=icecode.dev <contact@mail.primalhosted.com>
